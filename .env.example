# ── Required for a production build (the build stops if any is missing) ─────────────────────────────
# Backend API (your Railway URL, https, no trailing slash)
VITE_API_URL=https://your-api.up.railway.app
# Security pins: the ONLY contracts, chain and RPC this website will ever ask a wallet to use.
# Even if the API or database were hacked and served other addresses, the site refuses to trade.
VITE_MARKET_ADDRESS=0x...
VITE_FACTORY_ADDRESSES=0x...
VITE_CHAIN_ID=19480
VITE_RPC_URL=https://rpc.testnet.qms.finance

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────────
# Block explorer used for links (defaults to the one the API reports)
VITE_EXPLORER_URL=https://testnet.qmsscan.io
# Wrapped coin used for offers. Default: WQMS on QMS Testnet (0x9AA510295aC664A3d5A3182a3eFe959DE2B12c34).
# Must be the same address the marketplace contract was deployed with.
VITE_WRAPPED_ADDRESS=
# EIP-712 domain name of the marketplace contract (what wallets show when an order is signed).
# It is fixed in the contract's constructor. Default: "Quantly Market" (QuantlyMarket.sol), so leave this empty
# unless you change the name in the contract; then set the same name here and MARKET_DOMAIN_NAME in the backend.
VITE_MARKET_DOMAIN_NAME=
# Blocks to wait before a transaction is shown as done (QMS has no finality layer yet). Default 2.
VITE_CONFIRMATIONS=2
# Official collection's X link shown on the official-collection page
VITE_OFFICIAL_X=
